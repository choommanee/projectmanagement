# Postgres
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=platform
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# NATS
NATS_URL=nats://localhost:4222

# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_DB=audit

# Meilisearch
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=dev-master-key

# MinIO (S3-compatible)
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=platform

# Identity (refresh-token rotation, Plan #6 Task 2)
# Go duration. Default 720h (30 days).
REFRESH_TOKEN_TTL=720h

# Identity (password reset, Plan #6 Task 3)
# Go duration; default 1h. Base URL that the reset link is built from —
# the plaintext token is appended verbatim.
PASSWORD_RESET_TTL=1h
PASSWORD_RESET_LINK_URL=http://localhost:3000/reset-password?token=

# Identity (TOTP MFA, Plan #6 Task 4)
# 32-byte master key (64 hex chars). Generate one via: openssl rand -hex 32
# Per-tenant data keys are derived via HKDF-SHA256(salt=tenant_id_bytes,
# info="mfa_secret_v1"). Leaving this empty disables /v1/auth/mfa/* — dev
# only; production MUST set a real value.
MFA_MASTER_KEY=

# OpenTelemetry (opt-in; bring up via: docker compose up -d otel-collector jaeger)
# Defaults to OTLP HTTP on :4318. Use http://localhost:4317 for OTLP gRPC.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=
# Jaeger UI: http://localhost:16686
